app.post("/api/iiko/connect", async (req, res) => {

    res.json({
        success: true,
        message: "AnarSystem API работает",
        received: {
            ip: req.body.ip || null,
            port: req.body.port || null,
            login: req.body.login || null
        }
    });

});

